<footer>
  WasteWise — College Project Demo &nbsp;·&nbsp;
  MobileNetV2 Transfer Learning &nbsp;·&nbsp;
  Flask + TensorFlow backend
</footer>

<script>
  /* ── Constants ─────────────────────────────────────────────────────────── */
  const API_URL = 'http://localhost:5050/classify';

  const BIN_STYLES = {
    'Biodegradable':  { bg: '#3fb950', emoji: '🌿' },
    'Recyclable':     { bg: '#58a6ff', emoji: '♻️' },
    'Non-Recyclable': { bg: '#6e7681', emoji: '🗑️' },
    'Hazardous':      { bg: '#f85149', emoji: '☣️' },
  };

  /* ── DOM refs ───────────────────────────────────────────────────────────── */
  const fileInput      = document.getElementById('file-input');
  const dropZone       = document.getElementById('drop-zone');
  const previewWrap    = document.getElementById('preview-wrap');
  const previewImg     = document.getElementById('preview-img');
  const previewName    = document.getElementById('preview-name');
  const clearBtn       = document.getElementById('clear-btn');
  const classifyBtn    = document.getElementById('classify-btn');
  const btnLabel       = document.getElementById('btn-label');
  const btnSpinner     = document.getElementById('btn-spinner');
  const errorMsg       = document.getElementById('error-msg');
  const resultSection  = document.getElementById('result-section');
  const resultDot      = document.getElementById('result-dot');
  const resultCat      = document.getElementById('result-category');
  const resultBinLabel = document.getElementById('result-bin-label');
  const confText       = document.getElementById('confidence-text');
  const confFill       = document.getElementById('confidence-fill');
  const resultTip      = document.getElementById('result-tip');
  const scoresGrid     = document.getElementById('scores-grid');

  const steps = [
    document.getElementById('step-1'),
    document.getElementById('step-2'),
    document.getElementById('step-3'),
  ];

  let selectedFile = null;

  /* ── Pipeline step highlight ────────────────────────────────────────────── */
  function setStep(n) {           // n = 1-based
    steps.forEach((s, i) => s.classList.toggle('active', i < n));
  }

  /* ── File handling ──────────────────────────────────────────────────────── */
  function handleFile(file) {
    if (!file || !file.type.startsWith('image/')) {
      showError('Please select a valid image file.');
      return;
    }
    selectedFile = file;
    const url = URL.createObjectURL(file);
    previewImg.src = url;
    previewName.textContent = `${file.name}  (${(file.size / 1024).toFixed(1)} KB)`;
    previewWrap.style.display = 'block';
    classifyBtn.disabled = false;
    hideError();
    resultSection.style.display = 'none';
    setStep(1);
  }

  fileInput.addEventListener('change', e => handleFile(e.target.files[0]));

  /* Drag-and-drop */
  dropZone.addEventListener('dragover', e => {
    e.preventDefault();
    dropZone.classList.add('drag-over');
  });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
  dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    handleFile(e.dataTransfer.files[0]);
  });

  /* Clear */
  clearBtn.addEventListener('click', e => {
    e.stopPropagation();
    selectedFile = null;
    fileInput.value = '';
    previewImg.src = '';
    previewWrap.style.display = 'none';
    classifyBtn.disabled = true;
    resultSection.style.display = 'none';
    hideError();
    setStep(1);
  });

  /* ── Error helpers ──────────────────────────────────────────────────────── */
  function showError(msg) {
    errorMsg.textContent = msg;
    errorMsg.style.display = 'block';
  }
  function hideError() {
    errorMsg.style.display = 'none';
  }

  /* ── Classify ───────────────────────────────────────────────────────────── */
  classifyBtn.addEventListener('click', async () => {
    if (!selectedFile) return;

    // Loading state
    classifyBtn.disabled = true;
    btnLabel.textContent  = 'Analysing…';
    btnSpinner.style.display = 'block';
    hideError();
    resultSection.style.display = 'none';
    setStep(2);

    const formData = new FormData();
    formData.append('image', selectedFile);

    try {
      setStep(3);
      const res = await fetch(API_URL, { method: 'POST', body: formData });
      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || `Server error ${res.status}`);
      }

      renderResult(data);
    } catch (err) {
      if (err.name === 'TypeError') {
        showError('Cannot reach the server. Is the Flask app running on port 5050?');
      } else {
        showError(err.message);
      }
      setStep(1);
    } finally {
      classifyBtn.disabled = false;
      btnLabel.textContent  = 'Upload & Classify';
      btnSpinner.style.display = 'none';
    }
  });

  /* ── Render result ──────────────────────────────────────────────────────── */
  function renderResult(data) {
    const { category, confidence, bin_label, tip, all_scores } = data;
    const style = BIN_STYLES[category] || { bg: '#8b949e', emoji: '❓' };

    // Header
    resultDot.style.background = style.bg;
    resultDot.style.boxShadow  = `0 0 0 8px ${style.bg}22`;
    resultDot.textContent = style.emoji;
    resultCat.textContent = category;
    resultCat.style.color = style.bg;
    resultBinLabel.textContent = `📦  ${bin_label}`;

    // Confidence bar
    const pct = Math.round(confidence * 100);
    confText.textContent = `${pct}%`;
    confFill.style.background = style.bg;
    // Animate after a tick
    setTimeout(() => { confFill.style.width = `${pct}%`; }, 30);

    // Tip
    resultTip.textContent = tip;
    resultTip.style.borderLeftColor = style.bg;

    // All-class breakdown
    scoresGrid.innerHTML = '';
    const ORDER = ['Biodegradable', 'Recyclable', 'Non-Recyclable', 'Hazardous'];
    ORDER.forEach(cls => {
      const score = all_scores[cls] ?? 0;
      const pctCls = Math.round(score * 100);
      const s = BIN_STYLES[cls] || { bg: '#8b949e' };
      scoresGrid.innerHTML += `
        <div class="score-item">
          <div class="score-label">
            <span>${cls}</span>
            <span>${pctCls}%</span>
          </div>
          <div class="score-bar">
            <div class="score-fill" style="width:${pctCls}%; background:${s.bg};"></div>
          </div>
        </div>`;
    });

    resultSection.style.display = 'block';
    resultSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
</script>
</body>
</html>
